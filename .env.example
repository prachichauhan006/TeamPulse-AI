# Copy this file to .env for local development and replace every placeholder.
# Never commit the resulting .env file.
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=teampulse
POSTGRES_USER=teampulse
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Required: generate an independent random value, for example with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Docker Compose constructs DATABASE_URL and REDIS_URL automatically.
# For host-only backend development, set these separately with local credentials:
# DATABASE_URL=postgresql+psycopg://teampulse:your-local-password@localhost:5432/teampulse
# REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173
# Enable only behind a trusted proxy that overwrites/sanitizes forwarding headers.
TRUST_PROXY_HEADERS=false

# Server-side AI provider. Mock is offline and is the default.
AI_PROVIDER=mock
# Used only when AI_PROVIDER=openai_compatible. Never put a real key in this example file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional Groq chat-compatible setup (supply the key only in your runtime environment):
# AI_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=text-embedding-3-small
DOCUMENT_MAX_UPLOAD_MB=5

# Browser-facing URL used by the containerized Vite development server.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional development seed users. Passwords are supplied only at seed time.
SEED_OWNER_EMAIL=owner.demo@teampulse.app
SEED_ADMIN_EMAIL=admin.demo@teampulse.app
SEED_MEMBER_EMAIL=member.demo@teampulse.app
SEED_VIEWER_EMAIL=viewer.demo@teampulse.app
# Shared by the four local demo users; supply only at seed time and never print it.
SEED_USER_PASSWORD=
